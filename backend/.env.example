# Local development defaults to SQLite. Use PostgreSQL in production.
DATABASE_URL=sqlite:///./fintrack.db
ENVIRONMENT=development
FINTRACK_SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173

# Optional shared rate-limit storage for multi-instance production deployments.
# Use a private Redis/Valkey URL; defaults to process-local memory storage.
# RATE_LIMIT_STORAGE_URI=redis://...
